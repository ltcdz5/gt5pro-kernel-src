-		top_waiter = rt_mutex_top_waiter(lock);
-
-		/* [13] Drop locks */
-		raw_spin_unlock(&task->pi_lock);
-		raw_spin_unlock_irq(&lock->wait_lock);
-
-		/* If owner is not blocked, end of chain. */
-		if (!next_lock)
-			goto out_put_task;
-		goto again;
-	}
