-				arg > MAX_COMPRESS_LOG_SIZE) {
+				arg > MAX_SUPPORTED_COMPRESS_LOG_SIZE) {
 				f2fs_err(sbi,
 					"Compress cluster log size is out of range");
 				return -EINVAL;
