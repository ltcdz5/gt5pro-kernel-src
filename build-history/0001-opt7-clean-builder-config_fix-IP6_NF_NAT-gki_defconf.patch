-@@ -154,8 +154,27 @@ $(obj)/config_data.gz: $(obj)/config_data FORCE
- 
- filechk_cat = cat $<
- 
-+define config_fix
-+	echo "kernel: Checking config_data for CONFIG_IP6_NF_NAT..."; \
-+	if grep -q '^CONFIG_IP6_NF_NAT=y' $@; then \
