diff --git a/config.patch.1 b/config.patch.1
deleted file mode 100644
index 20f8e8996948..000000000000
--- a/config.patch.1
+++ /dev/null
@@ -1,32 +0,0 @@
-diff --git a/kernel/Makefile b/kernel/Makefile
-index df02908..f654c9b 100644
---- a/kernel/Makefile
