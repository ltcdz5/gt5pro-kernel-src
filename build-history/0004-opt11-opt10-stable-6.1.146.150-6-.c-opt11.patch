@@ -179,4 +179,4 @@ res=$(echo "$res" | sed 's/-dirty//g')
 res=$(echo "$res" | sed 's/-dirty//g')
 res=$(echo "$res" | sed 's/-dirty//g')
 res=$(echo "$res" | sed 's/-dirty//g')
