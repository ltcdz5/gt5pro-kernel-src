-        uint32_t nbBytes2 = (uint32_t)(DStream_start - *DStream_ptr);
-        *bitsConsumed += nbBytes2 << 3;
-        *DStream_ptr = DStream_start;
-        if (nbBytes == nbBytes2) {
-            return;
-        }
-    }
-    *bitContainer = MEM_readLEST(*DStream_ptr);
-}
